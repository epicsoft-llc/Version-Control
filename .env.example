# Copy to .env and fill in. The .env file is never committed.
#
# Nothing here has a working default on purpose: a value that is missing must
# fail or disable its feature, never quietly do something half right.

#### Database — required
VC_DATABASE_NAME=versioncontrol
VC_DATABASE_USERNAME=
VC_DATABASE_PASSWORD=

#### Port the dashboard is published on
VC_HTTP_PORT=8081

#### Which branch's images to run: main (default) or develop
VC_IMAGE_TAG=main

#### GitHub — optional.
#### Without a token the update check keeps working at the lower rate limit
#### (60 requests/hour instead of 5.000).
VC_GITHUB_TOKEN=

#### Telegram — optional.
#### Without a token the daily notification is not sent; the application logs
#### that once and carries on.
VC_TELEGRAM_BOT_TOKEN=
VC_TELEGRAM_CHAT_ID=

#### Translations — build time only, not needed to run the application.
#### Without a token the committed translation files are used as they are.
VC_TOLGEE_URL=
VC_TOLGEE_PROJECT_ID=
VC_TOLGEE_API_KEY=
